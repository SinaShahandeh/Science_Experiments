[Unit]
Description=Digital twin of the egg-white rig (python -m twin)
After=network.target

[Service]
User=aisim
Group=aisim
WorkingDirectory=/opt/aisim/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aisim/venv/bin/python -m twin --host 127.0.0.1 --port 8743 --speed 10
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/aisim/app/sim_sessions

[Install]
WantedBy=multi-user.target
