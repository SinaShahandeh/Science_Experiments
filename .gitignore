calibration/position.json

# Slicer outputs (re-slice from the .3mf)
*.gcode
*.gcode.3mf
/result.json

# Background research, not part of the device tooling
Agent_Harness_spec.md
Scientific_Agent_Harness_*.md
reports/
research_notes/
exa-results/

# Secrets
.env

# Run outputs: service sessions, digital-twin sessions, harness runs
sessions/
sim_sessions/
harness_runs/

# mhapi-service session folders (calls, temperatures, frames, cell images); the simulator's are separate
sessions/
sessions_sim/

# AI session transcripts: sent separately, never committed
claude_code_transcripts*.zip

# Phone recordings of the rig (GBs)
videos/

# LaTeX build intermediates (the PDF itself is tracked)
design_rationale/*.aux
design_rationale/*.fdb_latexmk
design_rationale/*.fls
design_rationale/*.log
design_rationale/*.out
design_rationale/*.synctex.gz

# Tilt logger output (bambu/tilt_logger.py), rewritten every 30 s
calibration/tilt_log.csv

# Superseded calibrations, kept locally only
calibration/archive_*/
calibration/recheck_*/

# Stray PDFs at the top level (not part of the project)
/*.pdf
